{
  "manifest_version": 3,
  "name": "抖音清爽刷 · 广告与直播跳过",
  "version": "0.1.0",
  "description": "在抖音网页版推荐流中自动跳过有明确标识的广告、推广和直播推荐，带货过滤可单独开启。所有设置保存在本机。",
  "permissions": ["storage"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "抖音清爽刷", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "commands": {
    "toggle-enabled": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "开启或暂停自动跳过"
    }
  },
  "content_scripts": [{
    "matches": ["https://www.douyin.com/*", "https://douyin.com/*"],
    "js": ["core.js", "content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}
